# TeamSync Frontend Vercel Environment Configuration
# Set this to your deployed backend API URL in Vercel Project Settings -> Environment Variables
# Example: https://api.yourdomain.com/api or https://team-sync-backend.onrender.com/api
VITE_API_BASE_URL=https://your-backend-api-url.com/api

# Optional: Application display name
VITE_APP_NAME="Team Sync"

